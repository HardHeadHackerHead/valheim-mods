<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Terminal</AssemblyName>
    <RootNamespace>Terminal</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedDir)/UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedDir)/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule"><HintPath>$(ManagedDir)/UnityEngine.TextCoreFontEngineModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestTextureModule"><HintPath>$(ManagedDir)/UnityEngine.UnityWebRequestTextureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(ManagedDir)/netstandard.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The settings the server decides in multiplayer, the cost, test commands that follow the cheat rule, the build-menu picture, piece reload (all shared with our other mods). -->
    <Compile Include="../Shared/ServerSettings.cs" Link="Shared/ServerSettings.cs" />
    <Compile Include="../Shared/Costs.cs" Link="Shared/Costs.cs" />
    <Compile Include="../Shared/TestCommands.cs" Link="Shared/TestCommands.cs" />
    <Compile Include="../Shared/Icon.cs" Link="Shared/Icon.cs" />
    <Compile Include="../Shared/PieceReload.cs" Link="Shared/PieceReload.cs" />
    <Compile Include="../Shared/SnapPoints.cs" Link="Shared/SnapPoints.cs" />
  </ItemGroup>
</Project>
