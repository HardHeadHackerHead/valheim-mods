<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>BountyBoard</AssemblyName>
    <RootNamespace>BountyBoard</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The settings and the cost the server decides in multiplayer (and no board built on a server without the mod; shared with our other mods). -->
    <Compile Include="../Shared/ServerSettings.cs" Link="Shared/ServerSettings.cs" />
    <Compile Include="../Shared/Costs.cs" Link="Shared/Costs.cs" /> <Compile Include="../Shared/PieceReload.cs" Link="Shared/PieceReload.cs" /> <Compile Include="../Shared/Icon.cs" Link="Shared/Icon.cs" />
    <Compile Include="../Shared/SnapPoints.cs" Link="Shared/SnapPoints.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- the build-menu picture, used if the game cannot draw one itself -->
    <EmbeddedResource Include="icon.png" LogicalName="icon.png" />
  </ItemGroup>
</Project>
