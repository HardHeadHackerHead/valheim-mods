<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>JetSkis</AssemblyName>
    <RootNamespace>JetSkis</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="netstandard"><HintPath>$(ManagedDir)/netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(ManagedDir)/UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The driving settings the server decides in multiplayer, and pieces that reload while you play (shared with our other mods). -->
    <Compile Include="../Shared/ServerSettings.cs" Link="Shared/ServerSettings.cs" />
    <Compile Include="../Shared/PieceReload.cs" Link="Shared/PieceReload.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The build menu's picture, once it is in the folder (else the raft's is used). -->
    <EmbeddedResource Include="icon-piece.png" LogicalName="icon-piece.png" Condition="Exists('icon-piece.png')" />
  </ItemGroup>
</Project>
