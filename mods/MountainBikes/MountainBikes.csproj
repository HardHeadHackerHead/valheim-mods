<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MountainBikes</AssemblyName>
    <RootNamespace>MountainBikes</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="netstandard"><HintPath>$(ManagedDir)/netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(ManagedDir)/UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedDir)/UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The driving settings and the cost the server decides in multiplayer (and no mountain bike built on a server without the mod),
         pieces that reload while you play, and the ground vehicle itself (shared with MountainBikes). -->
    <Compile Include="../Shared/ServerSettings.cs" Link="Shared/ServerSettings.cs" />
    <Compile Include="../Shared/Costs.cs" Link="Shared/Costs.cs" />
    <Compile Include="../Shared/PieceReload.cs" Link="Shared/PieceReload.cs" />
    <Compile Include="../Shared/GroundVehicle.cs" Link="Shared/GroundVehicle.cs" />
    <Compile Include="../Shared/VehicleMesh.cs" Link="Shared/VehicleMesh.cs" />
    <Compile Include="../Shared/VehicleRider.cs" Link="Shared/VehicleRider.cs" />
    <Compile Include="../Shared/VehicleTools.cs" Link="Shared/VehicleTools.cs" />
    <Compile Include="../Shared/Icon.cs" Link="Shared/Icon.cs" />
  </ItemGroup>
</Project>
