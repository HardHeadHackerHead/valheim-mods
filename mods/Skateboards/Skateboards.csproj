<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Skateboards</AssemblyName>
    <RootNamespace>Skateboards</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The strengths the server decides in multiplayer, the cheat rule for the test commands, the skill with its backup, and the
         skateboard item: its recipe and cost setting, and its icon drawn from the model (shared with our other mods). -->
    <Compile Include="../Shared/ServerSettings.cs" Link="Shared/ServerSettings.cs" />
    <Compile Include="../Shared/TestCommands.cs" Link="Shared/TestCommands.cs" />
    <Compile Include="../Shared/Skill.cs" Link="Shared/Skill.cs" />
    <Compile Include="../Shared/Costs.cs" Link="Shared/Costs.cs" />
    <Compile Include="../Shared/Content.cs" Link="Shared/Content.cs" />
    <Compile Include="../Shared/Icon.cs" Link="Shared/Icon.cs" />
    <!-- The skate park pieces: kept registered across a reload, and where they snap together. -->
    <Compile Include="../Shared/PieceReload.cs" Link="Shared/PieceReload.cs" />
    <Compile Include="../Shared/SnapPoints.cs" Link="Shared/SnapPoints.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The board's sounds, made in code (Sounds.cs), and the poses over the animation (Look.cs). -->
    <Reference Include="netstandard"><HintPath>$(ManagedDir)/netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedDir)/UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(ManagedDir)/UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="skill-icon.png" LogicalName="skill-icon.png" Condition="Exists('skill-icon.png')" />
  </ItemGroup>
</Project>
