<Project Sdk="Microsoft.NET.Sdk">
  <!-- The layout builder outside the game: compiles the mod's Model.cs, Layouts.cs and PackReader.cs against the game's own
       UnityEngine.CoreModule (its Vector3 and Bounds are plain C#) and lays out many seeds of a pack. See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>LayoutTest</AssemblyName>
    <RootNamespace>Dungeons</RootNamespace>
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(VALHEIM_DIR)</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == ''">D:/SteamLibrary/steamapps/common/Valheim</ValheimDir>
    <ManagedDir>$(ValheimDir)/valheim_Data/Managed</ManagedDir>
    <ModDir>$(MSBuildThisFileDirectory)../../mods/Dungeons</ModDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)/Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="netstandard"><HintPath>$(ManagedDir)/netstandard.dll</HintPath></Reference>
    <Compile Include="$(ModDir)/Model.cs" Link="Mod/Model.cs" />
    <!-- the boss toolkit's data and reader (dungeon-boss) -->
    <Compile Include="$(ModDir)/BossModel.cs" Link="Mod/BossModel.cs" />
    <Compile Include="$(ModDir)/PackReaderBoss.cs" Link="Mod/PackReaderBoss.cs" />
    <Compile Include="$(ModDir)/Layouts.cs" Link="Mod/Layouts.cs" />
    <Compile Include="$(ModDir)/PackReader.cs" Link="Mod/PackReader.cs" />
    <Compile Include="$(ModDir)/LayoutSolver.cs" Link="Mod/LayoutSolver.cs" />
    <Compile Include="$(ModDir)/LookCheck.cs" Link="Mod/LookCheck.cs" />
    <Compile Include="$(ModDir)/LayoutAudit.cs" Link="Mod/LayoutAudit.cs" />
    <Compile Include="$(ModDir)/TriggerModel.cs" Link="Mod/TriggerModel.cs" />
    <Compile Include="$(ModDir)/PackReaderTriggers.cs" Link="Mod/PackReaderTriggers.cs" />
    <Compile Include="$(ModDir)/TriggerSolve.cs" Link="Mod/TriggerSolve.cs" />
  </ItemGroup>
</Project>
