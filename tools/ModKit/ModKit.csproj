<Project Sdk="Microsoft.NET.Sdk">
  <!--
    modkit: Claude Tools' mod-maker commands on the command line, without the game running (check, who, clashes, game, gameupdate, library).
    Built twice from the same code: net48 is modkit.exe (Windows, nothing to install), net8.0 is modkit.dll (dotnet modkit.dll, Linux and Mac).
    It shares Claude Tools' own source files, so it answers exactly as the in-game commands do, and uses the Mono.Cecil and Newtonsoft.Json
    that come with the game (BepInEx/core, valheim_Data/Managed) instead of carrying copies. Claude Tools embeds both builds and writes them
    to BepInEx/claude/modkit.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <AssemblyName>modkit</AssemblyName>
    <RootNamespace>ClaudeTools</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RollForward>Major</RollForward>
    <UseAppHost>false</UseAppHost> <!-- (net8.0: run as "dotnet modkit.dll"; modkit.exe is the Windows build) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(VALHEIM_DIR)</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == '' and '$(OS)' == 'Windows_NT'">D:/SteamLibrary/steamapps/common/Valheim</ValheimDir>
    <ValheimDir Condition="'$(ValheimDir)' == '' and Exists('$(HOME)/.local/share/Steam/steamapps/common/Valheim/valheim.x86_64')">$(HOME)/.local/share/Steam/steamapps/common/Valheim</ValheimDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Mono.Cecil"><HintPath>$(ValheimDir)/BepInEx/core/Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ValheimDir)/valheim_Data/Managed/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="../../mods/ClaudeTools/Scan.cs" Link="Shared/Scan.cs" />
    <Compile Include="../../mods/ClaudeTools/Zip.cs" Link="Shared/Zip.cs" />
    <Compile Include="../../mods/ClaudeTools/Check.cs" Link="Shared/Check.cs" />
    <Compile Include="../../mods/ClaudeTools/Compat.cs" Link="Shared/Compat.cs" />
    <Compile Include="../../mods/ClaudeTools/GameIndex.cs" Link="Shared/GameIndex.cs" />
    <Compile Include="../Shared/Thunderstore.cs" Link="Shared/Thunderstore.cs" />
    <EmbeddedResource Include="../../mods/ClaudeTools/Shipped/patchmap.json.gz" LogicalName="library/shipped.json.gz" Condition="Exists('../../mods/ClaudeTools/Shipped/patchmap.json.gz')" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
</Project>
